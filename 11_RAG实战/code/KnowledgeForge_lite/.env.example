# KnowledgeForge Lite 环境变量模板（复制为 .env 后填写）。
# 也可以直接复用上一层 code/.env——config.py 会两个位置都读。

# OpenAI 兼容对话 / 向量端点（DeepSeek / 智谱 / 方舟 / 小米 MiMo 均可）
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.example.com/v1
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# 可选：与本章 code/.env 同一套小米 / 方舟变量名也认
# MIMO_API_KEY=
# MIMO_BASE_URL=
# MIMO_MODEL=
# ARK_API_KEY=
# ARK_BASE_URL=
# ARK_MODEL_ENDPOINT=

# 总装旋钮（不填即用默认）
# FORGE_LITE_ENABLE_REWRITE=1    # 11.6：是否追加一句查询改写
# FORGE_LITE_ENABLE_GRAPH=1      # 11.7：是否把图谱作为第三路召回
# FORGE_LITE_USER=it_staff       # 默认演示工牌：it_staff / hr_staff / finance_head / admin
# FORGE_LITE_CONTEXT_BUDGET=1800 # 11.5：喂给模型的上下文字符预算
# FORGE_LITE_TOP_K=6
# FORGE_LITE_THINKING_MODE=disabled             # 关 MiMo 隐性思考（完整版 LLM_THINKING_MODE 同语义）；问答和裁判都走它
# FORGE_LITE_JUDGE_MAX_TOKENS=8192              # Ragas 裁判单次生成上限（开思考时推理 token 也吃这份额度）
# FORGE_LITE_JUDGE_RELEVANCY_STRICTNESS=1       # AnswerRelevancy 连问几次；官方默认 3，课堂默认 1

# 可选：真图数据库（不配则自动降级 NetworkX）
# FORGE_LITE_NEO4J_URI=bolt://localhost:7687
# FORGE_LITE_NEO4J_USER=neo4j
# FORGE_LITE_NEO4J_PASSWORD=forge12345
