# ============================================
# Trip Assistant 环境变量配置模板
# 用法：复制本文件为 .env（cp .env.example .env），再填入你的真实 Key
# 注意：.env 含密钥，请勿提交到 Git（本项目 .gitignore 已忽略）
# ============================================

# ---------- 大模型（兼容 OpenAI 协议的任意服务） ----------
# 注意：OPENAI_MODEL_NAME 与 OPENAI_API_BASE 必须配套！
#
# 方案 A：OpenAI 官方
OPENAI_API_KEY="sk-xxxx"
OPENAI_MODEL_NAME="gpt-4o-mini"
OPENAI_API_BASE="https://api.openai.com/v1"
#
# 方案 B：DeepSeek（OpenAI 兼容接口）
# OPENAI_API_KEY="sk-xxxx"
# OPENAI_MODEL_NAME="deepseek-chat"
# OPENAI_API_BASE="https://api.deepseek.com/v1"
#
# 方案 C：Anthropic Claude（走兼容网关时示例，直连请用 langchain-anthropic 的 ChatAnthropic）
# OPENAI_API_KEY="sk-xxxx"
# OPENAI_MODEL_NAME="claude-sonnet-4-5"
# OPENAI_API_BASE="https://你的兼容网关地址/v1"

# ---------- Embedding（用于政策文档向量检索） ----------
# 默认复用上面 OPENAI_* 配置；如果 Embedding 走独立服务才需要单独设置
# EMBEDDING_API_KEY="sk-xxxx"
# EMBEDDING_API_BASE="https://api.openai.com/v1"
# EMBEDDING_MODEL_NAME="text-embedding-3-small"

# ---------- 全网搜索工具（主助理的 Tavily 工具，可选） ----------
# 不配、空着、或仍是占位符，主助理都没有这一件工具，订票 / 订酒店主流程不受影响。
# 免费申请：https://tavily.com
# TAVILY_API_KEY=""

# ---------- 注册 / 登录验证码 ----------
# 发验证码邮件用的 SMTP。不配也能跑：验证码会打进服务端日志，
# 本地会把验证码回给前端提示一下（dev 兜底），生产必须配 SMTP 并关掉兜底。
SMTP_HOST=""
SMTP_PORT="465"                 # 465 用 SSL，587 用 STARTTLS
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@example.com"
# 显式关掉本地兜底（配了 SMTP 后建议设成 0，避免验证码出现在日志里）
# TRIP_DESK_DEV_MAIL="0"

# ---------- 登录认证（JWT 签名密钥） ----------
# 工作台用 HS256 签发会话令牌，密钥换了所有已签发的令牌立刻失效。
# 不配也能跑（用开发默认值），但启动日志会提醒你换掉。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
TRIP_DESK_SECRET=""
