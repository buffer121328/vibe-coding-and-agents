# ==============================================================================
# 第十章 examples 环境变量配置文件 (OpenAI 兼容协议)
# 用法：复制本文件为 .env（cp .env.example .env），再填入你的真实 Key
# 注意：.env 含密钥，请勿提交到 Git（本项目 .gitignore 已忽略）
#
# ⚠️ 说明：本章 examples 全部示例「默认无需 API Key」——需要大模型的环节
# 用 langchain_core 内置假模型（按剧本返回）模拟。以下配置仅在你想把某个
# 示例的假模型替换为真实模型（ChatOpenAI）时才会用到。
# 变量名与 travel_agent_v2 完全一致，便于整章统一管理（见 16 节文档）。
# ==============================================================================

# ---------- 对话模型（OpenAI 兼容协议：model 与 base 必须配套） ----------
# 方案 A：小米 MiMo（OpenAI 兼容端点，支持工具调用）
OPENAI_API_KEY="your_mimo_api_key_here"
OPENAI_MODEL_NAME="mimo-v2.5-pro"
OPENAI_API_BASE="https://api.xiaomimimo.com/v1"
#
# 方案 B：火山方舟 DeepSeek（OpenAI 兼容端点）
# OPENAI_API_KEY="your_ark_api_key_here"
# OPENAI_MODEL_NAME="deepseek-v4-flash"
# OPENAI_API_BASE="https://ark.cn-beijing.volces.com/api/coding/v3"

# ---------- Embedding（向量检索用，可选；默认复用上面 OPENAI_*） ----------
# 若 Embedding 走独立服务才需要单独设置
# EMBEDDING_MODEL_NAME="text-embedding-3-small"
# EMBEDDING_API_KEY="sk-xxxx"
# EMBEDDING_API_BASE="https://api.openai.com/v1"

# ---------- 全网搜索工具（可选，未填则跳过初始化） ----------
# TAVILY_API_KEY="tvly-xxxx"
