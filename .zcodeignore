.DS_Store

# Python 项目产物（避免把虚拟环境与缓存提交进仓库）
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
env/

# 第三方依赖
node_modules/
site-packages/

# 环境变量：排除各目录内的真实 .env 密钥文件，保留 .env.example 模板
.env
.env.*
!.env.example

# 运行时 SQLite 数据库
*.db
**/.web_sessions.json

# Agent 演示运行时产物：记忆文件与 Gradio 会话数据（不入库）
agent_memory.json
gradio_agent_memory.json
gradio_sessions/

# RAG 教程运行时产物：11 章 s11 脚本生成的检索索引（删掉重跑即重建）
11_RAG实战/code/indexes/
# s02 清洗演示写的临时脏文档（跑完会删；旧版曾误写成仓库根下的 demo.md）
11_RAG实战/code/_demo_dirty.md
11_RAG实战/code/demo.md

# VitePress 文档站：docs 章节内容为 sync 脚本生成的产物（不入库），配置/首页/脚本入库
docs/[0-9][0-9]_*/
docs/.vitepress/dist/
docs/.vitepress/cache/


# 8.13 Mini-Agent CLI 运行时产物：会话存档与输入历史（不入库）
08_手搓Agent/code/sessions/
08_手搓Agent/code/.s13_repl_history
.zcode/

