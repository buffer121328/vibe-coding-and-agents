# ==============================================================================
# LangChain 1.0 环境变量配置文件 (支持任意 OpenAI 兼容大模型 + 双模型容灾)
# ==============================================================================

# ===================== 🥇 首选模型：小米 MiMo =====================
# 控制台: https://platform.xiaomimimo.com
MIMO_API_KEY=your_xiaomi_mimo_api_key_here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# ===================== 🥈 备选模型：火山方舟 DeepSeek =====================
# 控制台: https://console.volcengine.com/ark
ARK_API_KEY=your_volcengine_ark_api_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
ARK_MODEL_ENDPOINT=deepseek-v4-flash

# ===================== ⏱️ 首选模型超时与自动回退 =====================
# 首选模型（小米 MiMo）超过该秒数未响应 / 调用失败时，
# get_chat_model() 会自动切换到备选模型（火山方舟 DeepSeek）。
FALLBACK_TIMEOUT_SECONDS=45

# ===================== 🔤 向量 Embedding (RAG 章节使用, 可选) =====================
# 用于 9.8 RAG / 9.13 SmartBuyer 综合实战的文本向量化，填写任一 OpenAI 兼容 Embedding 端点。
# 未填则回落到 OPENAI_API_KEY / OPENAI_API_BASE。
OPENAI_API_KEY=your_embedding_api_key_here
OPENAI_API_BASE=https://ark.cn-beijing.volces.com/api/coding/v3
EMBEDDING_MODEL=your_embedding_model_name_here

# [可选：联网搜索 API Key (未填则默认使用 DuckDuckGo 免费搜索)]
# TAVILY_API_KEY=tvly-xxxx
